classDiagram
    %% PawPal+ final design (matches pawpal_system.py).

    class Priority {
        <<enumeration>>
        LOW = 1
        MEDIUM = 2
        HIGH = 3
    }

    class Category {
        <<enumeration>>
        WALK
        FEEDING
        MEDS
        ENRICHMENT
        GROOMING
        OTHER
    }

    class Frequency {
        <<enumeration>>
        ONCE
        DAILY
        WEEKLY
    }

    class Status {
        <<enumeration>>
        PENDING
        DONE
    }

    class Owner {
        +str name
        +int available_minutes
        +time day_start
        +list~str~ preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +remove_pet(name: str) None
        +get_pet(name: str) Optional~Pet~
        +get_all_tasks() list[tuple[Pet, Task]]
    }

    class Pet {
        +str name
        +str species
        +str breed
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(task_id: str) None
        +get_tasks() list~Task~
    }

    class Task {
        +str description
        +Category category
        +int duration_minutes
        +Priority priority
        +Optional~time~ preferred_time
        +Frequency frequency
        +date due_date
        +bool completed
        +Optional~date~ last_completed
        +str id
        +__post_init__() None
        +mark_complete(on: Optional~date~) Optional~Task~
        +next_occurrence() Optional~Task~
        +is_due(day: date) bool
        +time_window() Optional[tuple[int, int]]
    }

    class Scheduler {
        +Owner owner
        +schedule_walk(pet: Pet, duration_minutes: int, preferred_time: Optional~time~, priority: Priority) Task
        +get_todays_tasks(day: Optional~date~) list[tuple[Pet, Task]]
        +filter_tasks(pet_name: Optional~str~, status: Optional~Status~, day: Optional~date~) list[tuple[Pet, Task]]
        +sort_by_time(pairs: list[tuple[Pet, Task]])$ list[tuple[Pet, Task]]
        +detect_conflicts(day: Optional~date~, tasks: Optional[list]) list~str~
        +complete_task(task_id: str, on: Optional~date~) Optional~Task~
        +generate_plan(day: Optional~date~) DailyPlan
        -_select_within_budget(due: list) tuple[list, list]
        -_layout(chosen: list, plan: DailyPlan) list~ScheduledItem~
        -_drop_past_midnight(plan, pet, task, why)$ None
        -_sort_key(pair: tuple[Pet, Task]) tuple
        -_reason(task: Task) str
    }

    class DailyPlan {
        +date date
        +int available_minutes
        +list~ScheduledItem~ items
        +list[tuple[Pet, Task]] skipped
        +list~str~ conflicts
        +int total_minutes (property)
        +add_item(item: ScheduledItem) None
        +explain() str
        +display() str
    }

    class ScheduledItem {
        <<frozen>>
        +Pet pet
        +Task task
        +time start_time
        +str reason
        +time end_time (property)
        +bool ends_next_day (property)
        +str time_range (property)
    }

    Owner "1" o-- "*" Pet : owns
    Pet "1" *-- "*" Task : has
    Task --> Priority
    Task --> Category
    Task --> Frequency
    Task ..> Task : next occurrence
    Scheduler --> Owner : reads pets and tasks via get_all_tasks
    Scheduler ..> Status : filters by
    Scheduler ..> Task : creates walks, completes tasks
    Scheduler ..> DailyPlan : creates
    DailyPlan "1" *-- "*" ScheduledItem : contains
    DailyPlan --> Task : skipped
    ScheduledItem --> Task : wraps
    ScheduledItem --> Pet : for
